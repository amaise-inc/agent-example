<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath></relativePath>
    </parent>

    <groupId>ch.legali</groupId>
    <artifactId>agent-example-spring</artifactId>
    <version>1.18.3</version>
    <name>Agent Example (Spring)</name>
    <description>amaise Agent Example (Spring)</description>

    <properties>
        <!-- Java and Encoding -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Plugin and Development Versions -->
        <spotbugs.version>4.10.2</spotbugs.version>
        <spotless.version>2.46.1</spotless.version>
        <google-java-format.version>1.28.0</google-java-format.version>
        <dependency-check.version>12.2.2</dependency-check.version>
        <!-- dependency-check NVD auto-download; set false to reuse a pre-populated cache -->
        <owasp.autoUpdate>true</owasp.autoUpdate>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <spotbugs.maven.plugin.version>4.10.2.0</spotbugs.maven.plugin.version>
        <checkstyle.version>3.6.0</checkstyle.version>
        <!-- Override log4j2 to fix CVE-2026-34478/34480/34481 (≤ 2.25.3 vulnerable) -->
        <log4j2.version>2.26.0</log4j2.version>
        <!-- Override Tomcat to fix CVE-2026-55276/53434/53404 (11.0.22 vulnerable) -->
        <tomcat.version>11.0.23</tomcat.version>
        <!-- Override jackson 2 to fix CVE-2026-54515 (2.21.4 vulnerable); Spring Boot 4 splits this
             from the Jackson 3 tools.jackson bom (jackson-bom.version) -->
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <!-- spring-framework / micrometer overrides dropped: Spring Boot 4 ships Spring Framework 7
             (not in the ≤6.2.18 CVE range) and micrometer ≥1.16, so neither override is needed. -->
    </properties>


    <repositories>
        <repository>
            <id>amaise</id>
            <name>amaise Maven Repository</name>
            <url>https://repository.amaise.com/release</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Override pdfbox (transitive via agent-sdk) to fix CVE-2026-23907/33929 (3.0.7 vulnerable) -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>3.0.8</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Project Module -->
        <dependency>
            <groupId>ch.legali</groupId>
            <artifactId>agent-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Starters -->
        <!-- Spring Boot 4 removed Undertow (not Servlet 6.1 compatible); webmvc brings Tomcat. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Configuration Processor (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>agent</finalName>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all,-varargs,-processing,-cast</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs-annotations</artifactId>
                            <version>${spotbugs.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- SpotBugs -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.maven.plugin.version}</version>
                <configuration>
                    <excludeFilterFile>spotbugs_ignore.xml</excludeFilterFile>
                    <addSourceDirs>true</addSourceDirs>
                </configuration>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Spotless -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Markdown formatting handled by root-level Prettier (make format-markdown) -->
                    <formats>
                        <format>
                            <includes>
                                <include>.gitignore</include>
                            </includes>
                            <trimTrailingWhitespace />
                            <indent>
                                <tabs>true</tabs>
                                <spacesPerTab>4</spacesPerTab>
                            </indent>
                        </format>
                    </formats>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                    </java>
                </configuration>
            </plugin>

            <!-- Checkstyle -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <suppressionsLocation>checkstyle-suppressions.xml</suppressionsLocation>
                    <suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
                </configuration>
            </plugin>

            <!-- Dependency Check -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <dataDirectory>${user.home}/.depcheck-cache</dataDirectory>
                    <nvdValidForHours>24</nvdValidForHours>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <autoUpdate>${owasp.autoUpdate}</autoUpdate>
                    <skipProvidedScope>true</skipProvidedScope>
                    <skipRuntimeScope>true</skipRuntimeScope>
                    <skipSystemScope>true</skipSystemScope>
                    <skipTestScope>true</skipTestScope>
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <!-- NOTE(mba): disabled due to auth required -->
                    <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFile>./project-suppression.xml</suppressionFile>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Opt-in offline mode: set AMAISE_NVD_CACHED to scan a pre-populated NVD cache
             instead of downloading. Unset → live download. -->
        <profile>
            <id>ci-owasp-cached</id>
            <activation>
                <property>
                    <name>env.AMAISE_NVD_CACHED</name>
                </property>
            </activation>
            <properties>
                <owasp.autoUpdate>false</owasp.autoUpdate>
            </properties>
        </profile>
        <!-- Skip the OWASP dependency-check when SKIP_DEPENDENCY_AUDIT is set. The standalone
             agent-example repo sets it (no warmed NVD cache there and the NVD API is unstable);
             the monorepo CI leaves it unset so the scan runs. -->
        <profile>
            <id>skip-dependency-audit</id>
            <activation>
                <property>
                    <name>env.SKIP_DEPENDENCY_AUDIT</name>
                </property>
            </activation>
            <properties>
                <dependency-check.skip>true</dependency-check.skip>
            </properties>
        </profile>
    </profiles>
</project>
